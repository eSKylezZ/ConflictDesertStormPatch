#include <winver.h>
#include <winuser.h>

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "@CMAKE_SOURCE_DIR@/src/patcher/patcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "DesertStormFix Patcher (4 GB memory for Conflict: Desert Storm)"
            VALUE "FileVersion",      "@DS_VERSION_FULL@"
            VALUE "InternalName",     "DesertStormFix-Patcher"
            VALUE "OriginalFilename", "DesertStormFix-Patcher.exe"
            VALUE "ProductName",      "DesertStormFix"
            VALUE "ProductVersion",   "@DS_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
