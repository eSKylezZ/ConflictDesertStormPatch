# Menu bar / HUD colour for Conflict: Desert Storm (DesertStormFix): recoloured menu bars and HUD panels, readable text
# on them, and the colour wheel.
name     = dsfix.barcolour
requires = dsfix >= 3.3
# its mod data (Mods folder index, merged tables, mod weapons / skins ...) comes from dsfix.mods: load after it
after    = dsfix.mods
