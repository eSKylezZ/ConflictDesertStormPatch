# The mission briefing + loadout screen, kits, soldier gear, vehicle swaps and the mission overview for
# Conflict: Desert Storm (DesertStormFix).
name     = dsfix.loadout
requires = dsfix >= 3.3
# co-save chunks written before 2026-10-25, when gear and vehicle swaps were plugins of their own
adopts   = dsfix.gear, dsfix.vehicles
# its mod data (Mods folder index, merged tables, mod weapons / skins ...) comes from dsfix.mods: load after it
after    = dsfix.mods
