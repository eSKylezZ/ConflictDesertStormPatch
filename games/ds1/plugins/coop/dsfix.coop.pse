# Split screen, co-op, the CONTROLS menu, controllers (hot-plug, pad I/O), several keyboards / mice and VERSUS for
# Conflict: Desert Storm (DesertStormFix).
name     = dsfix.coop
requires = dsfix >= 3.3
# its mod data (Mods folder index, merged tables, mod weapons / skins ...) comes from dsfix.mods: load after it
after    = dsfix.mods
