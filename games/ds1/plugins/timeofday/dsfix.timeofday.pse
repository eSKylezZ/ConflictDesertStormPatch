# Time of day + day / night cycle for Conflict: Desert Storm (DesertStormFix). Uses dsfix.services, publishes
# dsfix.timeofday v1 (dsfix_timeofday.h).
name     = dsfix.timeofday
requires = dsfix >= 3.3
# its mod data (Mods folder index, merged tables, mod weapons / skins ...) comes from dsfix.mods: load after it
after    = dsfix.mods
