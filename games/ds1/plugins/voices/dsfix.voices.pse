# Squad voices (SAS / Delta accents, .skin voices) + your soldier talks, for Conflict: Desert Storm (DesertStormFix).
# Uses dsfix.services, publishes dsfix.voices v1 (dsfix_voices.h).
name     = dsfix.voices
requires = dsfix >= 3.3
# its mod data (Mods folder index, merged tables, mod weapons / skins ...) comes from dsfix.mods: load after it
after    = dsfix.mods
