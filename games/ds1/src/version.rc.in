#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription",  "@DS_RC_DESCRIPTION@"
            VALUE "FileVersion",      "@DS_VERSION_FULL@"
            VALUE "InternalName",     "@DS_RC_INTERNAL@"
            VALUE "OriginalFilename", "@DS_RC_FILENAME@"
            VALUE "ProductName",      "DesertStormFix"
            VALUE "ProductVersion",   "@DS_VERSION_FULL@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
