#ifndef DSFIX_OWN_KitWeaponIds
std::vector<std::string> features::KitWeaponIds() {
    const auto* t = Table();
    std::vector<std::string> out;
    const char* j = nullptr;
    if (t) {
        j = t->KitWeaponIds();
    }
    if (j && *j)
        for (const char* p = j;; ++p) {
            const char* e = p;
            while (*e && *e != '\x1E') ++e;
            out.emplace_back(p, e);
            if (!*e) break;
            p = e;
        }
    return out;
}
#endif
