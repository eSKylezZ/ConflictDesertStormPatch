  if ty == "string" then return cstr(v) end
  if ty == "boolean" then return v and 1 or 0 end
  if ty == "function" then
    local rva = CALLBACKS[v]
    if not rva then error("function handed to the game has no thunk") end
    return LO + rva
  end
  if v == nil then return 0 end
